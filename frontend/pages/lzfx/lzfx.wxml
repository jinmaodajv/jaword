<!--pages/lzfx/lzfx.wxml-->
<view style="height: 100vh;">

<scroll-view scroll-y enable-flex style="height: 90vh;">
  <view
    class="v-liebiao"
    wx:for="{{wordListData}}" wx:key="id"
    bindtap="xuanZhong" 
    data-id="{{item.id}}"
    data-state="{{item.state}}"
    id="{{item.id}}"
    style="{{item.isxz ? 'background-color: rgb(140, 204, 148);' : 'background-color: rgb(199, 223, 223);'}}"
  >
    <view class="v-name">
      <!-- 词汇集名称 -->
      <view class="v-na">
        <text class="text-name">{{item.name}}</text>
      </view>
      
      <!-- 点击查看详情 -->
      <view class="v-xc">
        <text catchtap="cxWord"
              data-id="{{item.id}}" 
              data-wordcount="{{item.wordcount}}"
              class="text-xc">点击查看详情</text>
      </view>

    </view>
    <view class="v-zshu">
      <!-- 单词总数 -->
      <view class="v-zs">
        <text class="text-zshu">单词总数</text>
      </view>
      <!-- 数量 -->
      <view class="v-zsh">
        <text class="text-zs">{{item.wordcount}}</text>
      </view>

    </view>
  </view>
</scroll-view>
<!-- 添加来自分享的词汇书 -->
  <view class="v-qr" style="height: 10vh;">
    <!-- 确认按钮 -->
    <button 
      type="primary" 
      bindtap="addFX" 
      class="b-queren"
      data-wlid="{{wordListData.wlId}}"
    >
      添加
    </button>
  </view>
</view>