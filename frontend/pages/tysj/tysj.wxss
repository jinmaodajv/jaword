/* pages/tysj/tysj.wxss */
/* 时间间隔和重复次数区域 */
.time-settings {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background-color: #f5f5f5;
  font-size: 16px;
  color: #333;
}

/* 选择器样式 */
.picker-view {
  position: fixed;
  bottom: 0;
  width: 100%;
  background-color: #fff;
  text-align: center;
  padding: 20rpx;
}













.text-xiangqing{
  font-size: 16px;
  font-weight: bold;
  color: rgb(100, 58, 58);
}


/* 词汇详情页样式 */
.text-name{
  font-size: 24px;
  font-weight: bold;
}

.text-kana{
  font-size: 14px;
  color: rgb(95, 87, 87);
}

.text-clazz{
  font-size: 15px;
  color: rgb(95, 87, 87);
}

.text-translate{
  font-size: 15px;
  font-weight: bold;
  color: rgb(59, 50, 50);
}

.text-shu{
  font-size: 14px;
  font-weight: bold;
  color: rgb(59, 55, 55);
}

.souchang{
  transition: height 1.5s ease;
  background-color: #fff;
  border-top: 1px solid #ddd;
  margin-bottom: -196rpx;
}

.favorite-i {
  justify-content: space-between;
  padding: 10px;
  border-bottom: 1px solid #eee;
}

.liju{
  position: relative; 
  left: 0rpx; 
  top: 193rpx;
  transition: height 0.3s ease;
}

.example-liju {
  margin: 20rpx;
  font-size: 18px;
  color: #333;
  display: block;
  margin-bottom: 10px;
}

.example-fanyi {
  margin: 20rpx;
  font-size: 16px;
  color: #666;
}


.favorite-item {
  display: flex;
  justify-content: space-between;
  padding: 10px;
  border-bottom: 1px solid #eee;
}

.favorite-name {
  font-size: 16px;
}

.favorite-count {
  font-size: 14px;
  color: #888;
}

.liju-item{
  margin: 20rpx;
  padding: 20rpx;
  background-color: rgb(208, 223, 223);
}

.example-cixing{
  margin: 20rpx;
  padding: 10rpx;
  background-color: rgb(229, 243, 243);
}

.text-cixing{
  font-size: 12px;
  color: rgb(95, 87, 87);
}

.example-siyi{
  margin: 20rpx;
  padding: 20rpx;
  background-color: rgb(227, 220, 230);
}

.text-siyi{
  font-size: 15px;
  color: rgb(107, 204, 196);
  font-weight: bold;
}